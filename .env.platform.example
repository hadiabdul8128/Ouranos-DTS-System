NODE_ENV=development
HOST=127.0.0.1
PORT=4100
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
DATABASE_SSL=disable
# Hosted Supabase connections use verify-full and the CA from Database Settings.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-server-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OCR_PROVIDER=disabled
# OCR_PROVIDER=http
# OCR_URL=https://your-partners-service.example/extract
# OCR_TOKEN=server-side-token
SCAN_PROVIDER=disabled
# SCAN_PROVIDER=http
# SCAN_URL=https://your-scanning-service.example/scan
# SCAN_TOKEN=server-side-token
DTS_PROVIDER=disabled
WORKER_POLL_MS=2000

# required = reviewer routing; automatic = internal server verification; preview = working-plan fallback.
APPROVAL_MODE=required

# Let every traveler demo-approve their own submitted authorization and open its voucher.
DEMO_APPROVAL_ALL_WORKSPACES=true
# When false, restrict demo approval to these comma-separated workspace IDs.
# DEMO_APPROVAL_ORGANIZATIONS=

# Built-in meetings (optional; server-only credentials)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-project-key
# LIVEKIT_API_SECRET=your-project-secret
