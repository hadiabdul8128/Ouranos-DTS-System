# syntax=docker/dockerfile:1
FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
RUN apt-get update \
    && apt-get install --yes --no-install-recommends tesseract-ocr tesseract-ocr-eng poppler-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --chown=node:node platform/providers ./platform/providers
COPY --chown=node:node voucher/src ./voucher/src
COPY --chown=node:node voucher/package.json ./voucher/package.json
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4200 OMP_THREAD_LIMIT=1
USER node
EXPOSE 4200
HEALTHCHECK --interval=30s --timeout=20s --start-period=180s --retries=3 \
  CMD node --input-type=module -e "const response = await fetch('http://127.0.0.1:4200/ready', {signal: AbortSignal.timeout(18000)}); if (!response.ok) process.exit(1)"
CMD ["node", "platform/providers/server.mjs"]
