{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.receipts"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 35,
    "startCommand": "node platform/providers/server.mjs",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 600
  }
}
